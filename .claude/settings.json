{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "my-ai-squad": {
      "source": { "source": "github", "repo": "matteopelucco/my-ai-squad" }
    }
  },
  "enabledPlugins": {
    "squad-core@my-ai-squad": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./config.yaml)"
    ]
  }
}
